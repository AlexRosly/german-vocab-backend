generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Article {
  der
  das
  die
  none
}

enum GrammaticalNumber {
  singular
  plural
  not_applicable
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum StudyAnswer {
  KNOWN
  NEEDS_REVIEW
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum WordPublicationStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model User {
  id                  String    @id @default(cuid())
  email               String?   @unique
  emailVerified       DateTime?
  interfaceLanguage   String    @default("ru")
  translationLanguage String    @default("ru")
  timeZone            String    @default("UTC")
  dailyGoal           Int       @default(10)
  role                UserRole  @default(USER)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts     Account[]
  authSessions AuthSession[]
  googleChallenges GoogleAuthChallenge[]
  words        UserWord[]
  progress     WordProgress[]
  sessions     StudySession[]
  personalNotes PersonalWordNote[]
  personalTranslations PersonalWordTranslation[]
  personalBooks PersonalWordBooks[]
  corrections WordCorrection[] @relation("CorrectionReporter")
  reviewedCorrections WordCorrection[] @relation("CorrectionReviewer")
  createdWords Word[]         @relation("WordCreator")

  @@map("users")
}

model Account {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  accessTokenHash  String   @unique
  refreshTokenHash String   @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

model Word {
  id                String                @id @default(cuid())
  german            String
  article           Article               @default(none)
  grammaticalNumber GrammaticalNumber     @default(not_applicable)
  translation       String
  pluralForm        String?
  level             CefrLevel?
  lessonNumber      Int?
  sourceBook        String?               @db.VarChar(120)
  notes             String?
  publicationStatus WordPublicationStatus @default(PUBLISHED)
  createdByUserId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  creator      User?              @relation("WordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  bookSources WordSourceBook[]
  translations WordTranslation[]
  examples     WordExample[]
  userWords    UserWord[]
  sessionWords StudySessionWord[]
  progress     WordProgress[]
  personalNotes PersonalWordNote[]
  personalTranslations PersonalWordTranslation[]
  personalBooks PersonalWordBooks[]
  corrections WordCorrection[]
  relationsFrom WordRelation[] @relation("RelationLeft")
  relationsTo WordRelation[] @relation("RelationRight")

  @@index([german])
  @@index([lessonNumber, level])
  @@index([publicationStatus])
  @@index([createdByUserId])
  @@map("words")
}

model UserWord {
  isFavorite Boolean @default(false)
  isArchived Boolean @default(false)
  revision String @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(64)
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([wordId])
  @@index([userId, isArchived])
  @@map("user_words")
}

model WordTranslation {
  id        String   @id @default(cuid())
  wordId    String
  language  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, language])
  @@index([language])
  @@map("word_translations")
}

model WordExample {
  id          String   @id @default(cuid())
  wordId      String
  german      String
  translation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  translations WordExampleTranslation[]

  @@index([wordId])
  @@map("word_examples")
}

model StudySession {
  id               String   @id @default(cuid())
  userId           String
  totalWords       Int
  knownCount       Int      @default(0)
  needsReviewCount Int      @default(0)
  startedAt        DateTime @default(now())
  completedAt      DateTime @default(now())

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  words StudySessionWord[]

  @@index([userId, startedAt])
  @@map("study_sessions")
}

model StudySessionWord {
  id         String      @id @default(cuid())
  sessionId  String
  wordId     String
  answer     StudyAnswer
  answeredAt DateTime    @default(now())

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word    Word         @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([sessionId, wordId])
  @@index([wordId, answeredAt])
  @@map("study_session_words")
}

model WordProgress {
  id                  String    @id @default(cuid())
  userId              String
  wordId              String
  knownCount          Int       @default(0)
  needsReviewCount    Int       @default(0)
  consecutiveKnown    Int       @default(0)
  currentIntervalDays Int       @default(0)
  lastReviewedAt      DateTime?
  nextReviewAt        DateTime?
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
  @@map("word_progress")
}

model WordExampleTranslation {
  id String @id @default(cuid())
  exampleId String
  language String
  text String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  example WordExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@unique([exampleId, language])
  @@index([language])
  @@map("word_example_translations")
}

// Independent of UserWord so a temporary dictionary unlink retains the note.
model PersonalWordNote {
  userId String
  wordId String
  text String @db.VarChar(2000)
  revision String @default(cuid()) @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@id([userId, wordId])
  @@index([wordId])
  @@map("personal_word_notes")
}

// One undirected edge, stored in canonical ASCII ID order.
model WordRelation {
  leftWordId String
  rightWordId String
  createdAt DateTime @default(now())
  leftWord Word @relation("RelationLeft", fields: [leftWordId], references: [id], onDelete: Cascade)
  rightWord Word @relation("RelationRight", fields: [rightWordId], references: [id], onDelete: Cascade)
  @@id([leftWordId, rightWordId])
  @@index([rightWordId])
  @@map("word_relations")
}

// Retained across dictionary unlink, readable only with an active readable UserWord.
model PersonalWordTranslation {
  userId String
  wordId String
  language String @db.VarChar(16)
  text String @db.VarChar(1000)
  revision String @default(cuid()) @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@id([userId, wordId, language])
  @@index([wordId])
  @@map("personal_word_translations")
}

model GoogleAuthChallenge {
  nonceHash String @id @db.VarChar(64)
  purpose String @db.VarChar(8)
  userId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("google_auth_challenges")
}

// Private book associations survive a temporary dictionary unlink, like personal notes.
model PersonalWordBooks {
  userId String
  wordId String
  titles String[]
  revision String @default(cuid()) @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@id([userId, wordId])
  @@index([wordId])
  @@map("personal_word_books")
}

enum CorrectionStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum CorrectionCategory {
  WORD
  TRANSLATION
  EXAMPLE
  RELATION
  OTHER
}

model WordCorrection {
  id String @id @default(cuid())
  wordId String
  reporterId String
  category CorrectionCategory
  description String @db.VarChar(2000)
  suggestion String? @db.VarChar(2000)
  snapshot Json
  status CorrectionStatus @default(OPEN)
  revision String @default(cuid()) @db.VarChar(64)
  reviewerId String?
  reviewComment String? @db.VarChar(1000)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  reporter User @relation("CorrectionReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User? @relation("CorrectionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  @@index([status, createdAt, id])
  @@index([reporterId, status, createdAt])
  @@index([wordId])
  @@map("word_corrections")
}

// Shared book/lesson provenance; private book titles stay in PersonalWordBooks.
model WordSourceBook {
  wordId String
  sourceBook String @db.VarChar(120)
  lessonNumbers Int[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@id([wordId, sourceBook])
  @@index([sourceBook])
  @@map("word_source_books")
}
