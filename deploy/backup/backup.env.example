# Private copy: ~/.config/wortkarten/backup.env, mode 600; never commit it.
# DATABASE_URL is inherited from the EXISTING app .env, not duplicated here.
WORTKARTEN_BACKUP_EXPECT_HOST=YOUR_CURRENT_NEON_HOST
WORTKARTEN_BACKUP_ROOT=/home/wortkarten/.local/state/wortkarten-backup
WORTKARTEN_BACKUP_JOB=wortkarten-production
RESTIC_REPOSITORY=rclone:wortkarten-drive:WortkartenBackups/production
RESTIC_PASSWORD_FILE=/home/wortkarten/.config/wortkarten/restic-password
RCLONE_CONFIG=/home/wortkarten/.config/rclone/rclone.conf
# Exact 64-character id from `restic cat config`, AFTER one manual init.
WORTKARTEN_BACKUP_REPOSITORY_ID=PASTE_REPOSITORY_ID
# Enable only after the first full archive and SQL restore acceptance.
# 14 daily, 8 weekly, 6 monthly recovery points; scoped to this job's tags/host.
WORTKARTEN_BACKUP_RETENTION=false
# Optional until setup; REQUIRED to consider R02 operationally complete.
# Copy your private Healthchecks ping URL; never post it to Git or chat.
WORTKARTEN_BACKUP_HEARTBEAT_URL=
